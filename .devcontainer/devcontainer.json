{
    "name": "GPMN Macroeconomic Modeling Workshop",

    "image": "mcr.microsoft.com/devcontainers/python:3.14",

    "postCreateCommand": "pip install 'irispie-ce>=0.80.5' ipython 'macrotap>=0.3.0'",

    "customizations": {
        "vscode": {
            "extensions": [
                "ms-python.python",
                "ms-python.vscode-python-envs"
            ],
            "settings": {
                "python.terminal.activateEnvironment": true
            }
        }
    }
}

